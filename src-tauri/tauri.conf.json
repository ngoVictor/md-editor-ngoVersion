{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "md-editor-alei",
  "version": "0.1.0",
  "identifier": "com.alei.md-editor.integration",
  "build": {
    "beforeDevCommand": "dev-server.cmd",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "build-frontend.cmd",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "MD 编辑器",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob: https: http:; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; frame-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "txt"],
        "name": "com.alei.md-editor.integration",
        "description": "Markdown 文档",
        "mimeType": "text/markdown"
      }
    ]
  }
}
